{
  // Tasks created by levinmisc::populate_targets_proj().
  //
  // VS Code and code-server load this file only when the project directory
  // itself is open as the workspace (File > Open Folder), and only after the
  // workspace is trusted. Run a task from the Command Palette ("Tasks: Run Task").
  //
  // To run the whole cycle with one key, add this to your user keybindings.json
  // (Command Palette: "Preferences: Open Keyboard Shortcuts (JSON)"):
  //   {
  //     "key": "ctrl+shift+r",
  //     "command": "workbench.action.tasks.runTask",
  //     "args": "Pull, render, and run pipeline"
  //   }
  //
  // To run tar_make() in the active R terminal (for example arf) instead:
  //   {
  //     "key": "ctrl+shift+m",
  //     "command": "workbench.action.terminal.sendSequence",
  //     "args": { "text": "targets::tar_make()\u000D" }
  //   }
  //
  // The pipeline runs inside the code-server job, so it stops if that job ends.
  // Request a session long enough for the whole pipeline.
  //
  // Tasks run in a non-login shell ("-c"). A login shell ("-lc") would run the
  // compute node's /etc/profile scripts, which on the LPC refuse sessions that
  // did not start through LSF ("no direct access allowed"). The `module`
  // command still works, because the code-server session passes it on.
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "/bin/bash",
      "args": ["-c"]
    }
  },
  "tasks": [
    {
      "label": "Pull from GitHub",
      "type": "shell",
      "command": "git pull --rebase --autostash",
      "problemMatcher": []
    },
    {
      "label": "Render pipeline",
      "type": "shell",
      "command": "module load {{{r_module}}} && quarto render \"{{{title}}}-Pipeline.qmd\"",
      "problemMatcher": []
    },
    {
      "label": "Run pipeline",
      "type": "shell",
      "command": "module load {{{r_module}}} && Rscript .run-pipeline.R",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Pull, render, and run pipeline",
      "dependsOrder": "sequence",
      "dependsOn": ["Pull from GitHub", "Render pipeline", "Run pipeline"],
      "problemMatcher": []
    },
    {
      "label": "Render results",
      "type": "shell",
      "command": "module load {{{r_module}}} && quarto render \"{{{title}}}-Results.qmd\"",
      "problemMatcher": []
    }
  ]
}
